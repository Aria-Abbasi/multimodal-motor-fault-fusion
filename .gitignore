# Python
__pycache__/
*.py[cod]
*.so

# Virtual environments
.venv/
venv/

# OS/editor
.DS_Store
.vscode/

# Ignore Model Weights and Logs
artifacts/checkpoints/
artifacts/logs/
results/runs/
*.pth

# Ignore raw, interim, and generated processed data
data/raw/
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
*.pt

# Keep compact reproducibility CSVs, not generated inspection logs
data/metadata/*
!data/metadata/.gitkeep
!data/metadata/metadata_master.csv
!data/metadata/paderborn_channel_schema.csv
!data/metadata/raw_manifest.csv

data/splits/*
!data/splits/.gitkeep
!data/splits/*.csv

# Ignore large archives
*.zip
*.tar.gz
